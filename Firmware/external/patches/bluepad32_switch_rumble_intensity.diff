-    data[2] = freq_data_low.low + ((amp_data.low >> 8) & 0xFF);
-    data[3] = amp_data.low & 0xFF;
+    data[0] = (freq.high >> 8) & 0xFF;
+    data[1] = (freq.high & 0xFF) + high_amp.high;
+    data[2] = freq.low + ((low_amp.low >> 8) & 0xFF);
+    data[3] = low_amp.low & 0xFF;
 }
 
