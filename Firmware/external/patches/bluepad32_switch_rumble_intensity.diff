diff --git a/src/components/bluepad32/parser/uni_hid_parser_switch.c b/src/components/bluepad32/parser/uni_hid_parser_switch.c
index a6b25b3..98d6ee9 100644
--- a/src/components/bluepad32/parser/uni_hid_parser_switch.c
+++ b/src/components/bluepad32/parser/uni_hid_parser_switch.c
@@ -1727,6 +1727,19 @@ static struct switch_rumble_amp_data find_rumble_amp(uint16_t amp) {
     return rumble_amps[i];
 }
 
+// Rumble intensity: switch_play_dual_rumble_now used to pass the requested 0-255 magnitude as a
+// *frequency* here and a fixed amplitude (500), so every non-zero magnitude buzzed at roughly the
+// same strength instead of following what the host asked for. DS4Windows (SwitchProDevice.cs,
+// PrepareRumbleData) keeps the frequency fixed at 320 Hz in both bands and maps the magnitude to
+// the amplitude table instead -- do the same here. 800 of the table's max 1003 mirrors
+// DS4Windows's own safety cap (AMP_LIMIT_MAX).
+#define SWITCH_RUMBLE_FIXED_FREQ_HZ 320
+#define SWITCH_RUMBLE_AMP_CAP 800
+
+static uint16_t switch_magnitude_to_amp(uint8_t magnitude) {
+    return (uint16_t)((magnitude * SWITCH_RUMBLE_AMP_CAP) / 255);
+}
+
 static void switch_encode_rumble(uint8_t* data, uint16_t freq_low, uint16_t freq_high, uint16_t amp) {
     struct switch_rumble_freq_data freq_data_low;
     struct switch_rumble_freq_data freq_data_high;
@@ -1921,8 +1934,10 @@ static void switch_play_dual_rumble_now(uni_hid_device_t* d,
     struct switch_subcmd_request req = {
         .report_id = OUTPUT_RUMBLE_ONLY,
     };
-    switch_encode_rumble(req.rumble_left, weak_magnitude << 2, weak_magnitude, 500);
-    switch_encode_rumble(req.rumble_right, strong_magnitude << 2, strong_magnitude, 500);
+    switch_encode_rumble(req.rumble_left, SWITCH_RUMBLE_FIXED_FREQ_HZ, SWITCH_RUMBLE_FIXED_FREQ_HZ,
+                         switch_magnitude_to_amp(weak_magnitude));
+    switch_encode_rumble(req.rumble_right, SWITCH_RUMBLE_FIXED_FREQ_HZ, SWITCH_RUMBLE_FIXED_FREQ_HZ,
+                         switch_magnitude_to_amp(strong_magnitude));
 
     // Rumble request don't include the last byte of "switch_subcmd_request": subcmd_id
     send_subcmd(d, &req, sizeof(req) - 1);
