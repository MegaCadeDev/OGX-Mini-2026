+// Rumble: both actuators get the same data, as SDL sends it (SDL_hidapi_switch.c,
+// HIDAPI_DriverSwitch_ActuallyRumbleJoystick): the weak magnitude sets the high-band amplitude
+// and the strong one the low-band amplitude, both bands at ~150 Hz. A single Joy-Con only has one
+// actuator, so each side must carry both magnitudes. Magnitudes map onto the full amplitude table
+// (0..1003). The magnitude used to be encoded as a frequency with a fixed amplitude (500), so every
+// non-zero rumble buzzed at about the same strength.
+#define SWITCH_RUMBLE_FREQ_HZ 150
+#define SWITCH_RUMBLE_AMP_MAX 1003
 
-    freq_data_low = find_rumble_freq(freq_low);
-    freq_data_high = find_rumble_freq(freq_high);
-    amp_data = find_rumble_amp(amp);
+static uint16_t switch_magnitude_to_amp(uint8_t magnitude) {
+    return (uint16_t)((magnitude * SWITCH_RUMBLE_AMP_MAX) / 255);
+}
+
+static void switch_encode_dual_rumble(uint8_t* data, uint8_t weak_magnitude, uint8_t strong_magnitude) {
+    const struct switch_rumble_freq_data freq = find_rumble_freq(SWITCH_RUMBLE_FREQ_HZ);
+    const struct switch_rumble_amp_data high_amp = find_rumble_amp(switch_magnitude_to_amp(weak_magnitude));
+    const struct switch_rumble_amp_data low_amp = find_rumble_amp(switch_magnitude_to_amp(strong_magnitude));
 
-    data[0] = (freq_data_high.high >> 8) & 0xFF;
