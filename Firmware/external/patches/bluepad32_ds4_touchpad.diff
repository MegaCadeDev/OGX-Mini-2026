+void uni_hid_parser_ds4_get_touchpad(uni_hid_device_t* d, uint8_t touch_points[8], bool* touchpad_click) {
+    if (!d || !touch_points || !touchpad_click)
+        return;
+    ds4_instance_t* ins = get_ds4_instance(d);
+    if (ins->touch_valid) {
+        memcpy(touch_points, ins->touch_points, 8);
+    } else {
+        memset(touch_points, 0, 8);
+        touch_points[0] = 0x80;  // not touching
+        touch_points[4] = 0x80;
+    }
+    *touchpad_click = ins->touchpad_click;
+}
