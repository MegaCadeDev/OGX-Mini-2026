diff --git a/src/components/bluepad32/include/uni_diag_hooks.h b/src/components/bluepad32/include/uni_diag_hooks.h
new file mode 100644
index 0000000..dea4456
--- /dev/null
+++ b/src/components/bluepad32/include/uni_diag_hooks.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: Apache-2.0
+// OGX-Mini-improved: optional diagnostics hooks. Weak no-op defaults in uni_hid_parser.c; an
+// application defines them to see raw input reports and BLE Device Information values.
+
+#ifndef UNI_DIAG_HOOKS_H
+#define UNI_DIAG_HOOKS_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct uni_hid_device_s;
+
+// Every input report, before it is parsed (report[0] is the report ID).
+void uni_diag_on_input_report(struct uni_hid_device_s* d, const uint8_t* report, uint16_t report_len);
+
+// Every GATT service event of the BLE Device Information query (HCI_EVENT_GATTSERVICE_META).
+void uni_diag_on_device_information(const uint8_t* packet, uint16_t size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // UNI_DIAG_HOOKS_H
