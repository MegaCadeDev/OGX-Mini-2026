+// Only one Switch pad runs its setup FSM at a time. When both Joy-Cons reconnect together
+// (e.g. after the adapter reboots), interleaved subcommand traffic made one setup time out
+// and leave the pad connected but never ready.
+static uni_hid_device_t* s_setup_owner = NULL;
+static uint32_t s_setup_owner_since_ms = 0;
+static btstack_timer_source_t s_setup_defer_timer[CONFIG_BLUEPAD32_MAX_DEVICES];
+
+static bool switch_setup_busy_by_other(uni_hid_device_t* d) {
+    if (s_setup_owner == NULL || s_setup_owner == d)
+        return false;
+    if (btstack_run_loop_get_time_ms() - s_setup_owner_since_ms >= SWITCH_SETUP_OWNER_STALE_MS) {
+        logi("Switch: previous setup owner is stale, taking over\n");
+        s_setup_owner = NULL;
+        return false;
+    }
+    return true;
+}
+
+static void switch_setup_release_owner(uni_hid_device_t* d) {
+    if (s_setup_owner == d)
+        s_setup_owner = NULL;
+}
+
+static void switch_setup_start(uni_hid_device_t* d) {
+    switch_instance_t* ins = get_switch_instance(d);
+    s_setup_owner = d;
+    s_setup_owner_since_ms = btstack_run_loop_get_time_ms();
+    ins->state = STATE_SETUP;
+    process_fsm(d);
+}
+
+static void switch_setup_defer_cb(btstack_timer_source_t* ts) {
+    uni_hid_device_t* d = btstack_run_loop_get_timer_context(ts);
+    switch_instance_t* ins = get_switch_instance(d);
+    // Deleted or already started meanwhile.
+    if (ins->state != STATE_SETUP || d->report_parser.setup != uni_hid_parser_switch_setup)
+        return;
+    if (switch_setup_busy_by_other(d)) {
+        btstack_run_loop_set_timer(ts, SWITCH_SETUP_DEFER_MS);
+        btstack_run_loop_add_timer(ts);
+        return;
+    }
+    logi("Switch: starting deferred setup\n");
+    switch_setup_start(d);
+}
+
+static void switch_setup_arm_step_timer(uni_hid_device_t* d) {
+    switch_instance_t* ins = get_switch_instance(d);
+    btstack_run_loop_remove_timer(&ins->setup_timer);
+    btstack_run_loop_set_timer(&ins->setup_timer, SWITCH_SETUP_STEP_TIMEOUT_MS);
+    btstack_run_loop_add_timer(&ins->setup_timer);
+}
+
+// Subcommand whose 0x21 reply advances the FSM from the given state (0 = none).
+static uint8_t switch_expected_subcmd(enum switch_state state) {
+    switch (state) {
+        case STATE_REQ_DEV_INFO:
+            return SUBCMD_REQ_DEV_INFO;
+        case STATE_READ_FACTORY_STICK_CALIBRATION:
+        case STATE_READ_USER_STICK_CALIBRATION:
+        case STATE_READ_FACTORY_IMU_CALIBRATION:
+        case STATE_DUMP_FLASH:
+            return SUBCMD_SPI_FLASH_READ;
+        case STATE_SET_FULL_REPORT:
+            return SUBCMD_SET_REPORT_MODE;
+        case STATE_ENABLE_IMU:
+            return SUBCMD_ENABLE_IMU;
+        case STATE_ENABLE_VIBRATION:
+            return SUBCMD_ENABLE_VIBRATION;
+        case STATE_UPDATE_LED:
+            return SUBCMD_SET_PLAYER_LEDS;
+        default:
+            return 0;
+    }
+}
+
+// Resend the request of the current setup step (after a lost reply).
+static void switch_fsm_resend_current_step(uni_hid_device_t* d) {
+    switch_instance_t* ins = get_switch_instance(d);
+    switch (ins->state) {
+        case STATE_REQ_DEV_INFO:
+            fsm_request_device_info(d);
+            break;
+        case STATE_READ_FACTORY_STICK_CALIBRATION:
+            fsm_read_factory_stick_calibration(d);
+            break;
+        case STATE_READ_USER_STICK_CALIBRATION:
+            fsm_read_user_stick_calibration(d);
+            break;
+        case STATE_READ_FACTORY_IMU_CALIBRATION:
+            fsm_read_factory_imu_calibration(d);
+            break;
+        case STATE_SET_FULL_REPORT:
+            fsm_set_full_report(d);
+            break;
+        case STATE_ENABLE_IMU:
+            fsm_enable_imu(d);
+            break;
+        case STATE_ENABLE_VIBRATION:
+            fsm_enable_vibration(d);
+            break;
+        case STATE_UPDATE_LED:
+            fsm_update_led(d);
+            break;
+        default:
+            process_fsm(d);
+            return;
+    }
+    switch_setup_arm_step_timer(d);
+}
+
+void uni_hid_parser_switch_cleanup(struct uni_hid_device_s* d) {
+    if (!d || d->report_parser.setup != uni_hid_parser_switch_setup)
+        return;
+    switch_instance_t* ins = get_switch_instance(d);
+    // Timers live in parser_data, which is wiped on delete: unlink them from the run loop first.
+    btstack_run_loop_remove_timer(&ins->setup_timer);
+    btstack_run_loop_remove_timer(&ins->rumble_timer_duration);
+    btstack_run_loop_remove_timer(&ins->rumble_timer_delayed_start);
+    int idx = uni_hid_device_get_idx_for_instance(d);
+    if (idx >= 0 && idx < CONFIG_BLUEPAD32_MAX_DEVICES)
+        btstack_run_loop_remove_timer(&s_setup_defer_timer[idx]);
+    switch_setup_release_owner(d);
+}
+
