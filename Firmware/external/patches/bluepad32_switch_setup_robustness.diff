+        int idx = uni_hid_device_get_idx_for_instance(d);
+        if (idx >= 0 && idx < CONFIG_BLUEPAD32_MAX_DEVICES) {
+            logi("Switch: another Switch pad is in setup, deferring this one\n");
+            btstack_timer_source_t* ts = &s_setup_defer_timer[idx];
+            btstack_run_loop_remove_timer(ts);
+            btstack_run_loop_set_timer_context(ts, d);
+            btstack_run_loop_set_timer_handler(ts, &switch_setup_defer_cb);
+            btstack_run_loop_set_timer(ts, SWITCH_SETUP_DEFER_MS);
+            btstack_run_loop_add_timer(ts);
+            return;
